"code":101,"indent":0,"parameters":["Marga",0,0,2,"Marga la rancia"]},{"code":401,"indent":0,"parameters":["Y por último, dile al herrero que ya es"]},{"code":401,"indent":0,"parameters":["hora de que me arregle la escoba."]},{"code":401,"indent":0,"parameters":["¡Llevo semanas volando en zigzag!"]},{"code":101,"indent":0,"parameters":["Marga",0,0,2,"Marga la rancia"]},{"code":401,"indent":0,"parameters":["Cuando termines todo, vuelve conmigo."]},{"code":401,"indent":0,"parameters":["Si no te has perdido antes, claro."]},{"code":121,"indent":0,"parameters":[21,21,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":43,"itemValid":true,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":23,"switch1Valid":true,"switch2Id":22,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":516,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["Evil",2,0,2,"Marga la rancia"]},{"code":401,"indent":0,"parameters":["¡Vaya, vaya, qué sorpresa!  "]},{"code":401,"indent":0,"parameters":["Pensé que te rendirías en el cementerio,  "]},{"code":401,"indent":0,"parameters":["pero aquí estás, con cara de misión cumplida."]},{"code":101,"indent":0,"parameters":["Evil",2,0,2,"Marga la rancia"]},{"code":401,"indent":0,"parameters":["Has hecho todo:  "]},{"code":401,"indent":0,"parameters":["la oración a Elyndra, la carne del mercado  "]},{"code":401,"indent":0,"parameters":["y el recado al herrero.  "]},{"code":401,"indent":0,"parameters":["No está mal para alguien sin escoba propia."]},{"code":101,"indent":0,"parameters":["Evil",2,0,2,"Marga la rancia"]},{"code":401,"indent":0,"parameters":["Como prometí, te mos